# ── Telegram Bot ──────────────────────────────────────
# Створити бота через @BotFather → /newbot
# Додати бота як адміна у канал (з правом редагувати повідомлення)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID каналу (можна отримати через @userinfobot або пересилаючи повідомлення боту @raw_data_bot)
TELEGRAM_CHAT_ID=-1002345678901

# ID повідомлення зі статистикою (отримаєте після виклику GET /api/init)
TELEGRAM_MESSAGE_ID=

# ── Upstash Redis (безкоштовний тариф) ────────────────
# Зареєструватися на https://upstash.com/ → створити Redis базу
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
